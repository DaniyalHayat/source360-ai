{
  "AWSTemplateFormatVersion":"2010-09-09",
  "Description":"Temporary synthetic procurement raw zone with private encrypted storage and access logging; no always-on compute.",
  "Resources":{
    "AccessLogs":{"Type":"AWS::S3::Bucket","DeletionPolicy":"Delete","UpdateReplacePolicy":"Delete","Metadata":{"com.aws.cloudformation.Context":{"why":"Isolate access logs from raw files; disposable synthetic verification stack","must":["No confidential input","Delete only stack-owned objects during cleanup"]}},"Properties":{"PublicAccessBlockConfiguration":{"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true},"OwnershipControls":{"Rules":[{"ObjectOwnership":"BucketOwnerEnforced"}]},"BucketEncryption":{"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},"LifecycleConfiguration":{"Rules":[{"Id":"ExpireLogs","Status":"Enabled","ExpirationInDays":7}]}}},
    "LogPolicy":{"Type":"AWS::S3::BucketPolicy","Properties":{"Bucket":{"Ref":"AccessLogs"},"PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"logging.s3.amazonaws.com"},"Action":"s3:PutObject","Resource":{"Fn::Sub":"${AccessLogs.Arn}/access/*"},"Condition":{"StringEquals":{"aws:SourceAccount":{"Ref":"AWS::AccountId"}},"ArnLike":{"aws:SourceArn":{"Fn::GetAtt":["RawZone","Arn"]}}}},{"Effect":"Deny","Principal":"*","Action":"s3:*","Resource":[{"Fn::GetAtt":["AccessLogs","Arn"]},{"Fn::Sub":"${AccessLogs.Arn}/*"}],"Condition":{"Bool":{"aws:SecureTransport":"false"}}}]}}},
    "RawZone":{"Type":"AWS::S3::Bucket","DeletionPolicy":"Delete","UpdateReplacePolicy":"Delete","Metadata":{"com.aws.cloudformation.Context":{"why":"Small immutable raw landing zone for actual S3 upload/download verification; disposable test data permits deletion","must":["Private bucket","Encrypt at rest and in transit","Synthetic files only","No compute resources"]}},"Properties":{"PublicAccessBlockConfiguration":{"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true},"BucketEncryption":{"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},"VersioningConfiguration":{"Status":"Enabled"},"LoggingConfiguration":{"DestinationBucketName":{"Ref":"AccessLogs"},"LogFilePrefix":"access/"},"LifecycleConfiguration":{"Rules":[{"Id":"ExpireSyntheticRaw","Status":"Enabled","ExpirationInDays":7,"NoncurrentVersionExpiration":{"NoncurrentDays":1},"AbortIncompleteMultipartUpload":{"DaysAfterInitiation":1}}]}}},
    "RawPolicy":{"Type":"AWS::S3::BucketPolicy","Properties":{"Bucket":{"Ref":"RawZone"},"PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Deny","Principal":"*","Action":"s3:*","Resource":[{"Fn::GetAtt":["RawZone","Arn"]},{"Fn::Sub":"${RawZone.Arn}/*"}],"Condition":{"Bool":{"aws:SecureTransport":"false"}}}]}}}
  },
  "Outputs":{"RawBucket":{"Description":"Private synthetic raw landing bucket","Value":{"Ref":"RawZone"}},"LogBucket":{"Description":"Private access-log destination","Value":{"Ref":"AccessLogs"}}}
}
